# Copia questo file in backend/.env e sostituisci i valori.
# Non committare mai il file .env: contiene password e chiavi.

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000

# Database (sviluppo: il MySQL di docker-compose.yml, porta 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USER=app_user
DB_PASSWORD=cambia-questa-password
DB_NAME=sql_auth
DB_AUTH_DATABASE=sql_auth
DB_TEMPLATE=sql_template
DB_SSL=false
MYSQL_ROOT_PASSWORD=cambia-questa-password
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=cambia-questa-password

# Produzione su TiDB Serverless: porta 4000, SSL obbligatorio,
# utente con il prefisso del cluster (es. xxxxxxxxxxxxxxx.root)
# DB_HOST=gateway01.eu-central-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_SSL=true

# Autenticazione (genera stringhe lunghe e casuali, es. `openssl rand -hex 32`)
JWT_SECRET=genera-una-stringa-casuale
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=genera-un-altra-stringa-casuale
REFRESH_TOKEN_SECRET=genera-un-altra-stringa-casuale
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Email (verifica account e recupero password)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=password-della-casella
EMAIL_FROM_NAME=QueryForge
EMAIL_FROM_ADDRESS=noreply@example.com
REQUIRE_EMAIL_VERIFICATION=true

# Limiti e protezione dagli abusi
DEFAULT_USER_PLAN=free
FREE_QUERY_DAILY_LIMIT=50
ACCOUNT_CREATION_LIMIT=3
ACCOUNT_DELETION_LIMIT=3
ABUSE_TIME_WINDOW_HOURS=24
DATABASE_QUERY_LIMIT=30
DATABASE_QUERY_TIME_WINDOW_MINUTES=1
DATABASE_RESET_LIMIT=5
DATABASE_RESET_TIME_WINDOW_HOURS=1
MANUAL_BACKUP_LIMIT=10
ESTIMATED_CONCURRENT_USERS=25

# Facoltativo: Redis per i log in produzione
# REDIS_URL=redis://localhost:6379
